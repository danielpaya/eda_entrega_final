table dim_calendario
	lineageTag: 8820e218-bad5-4dd6-af42-43014e365aa5
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: ce41f37c-252d-4d91-8d8f-5208ce82157b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fecha]

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		formatString: 0
		lineageTag: fdd1b4b6-af2c-463f-a11b-2de2666f8550
		summarizeBy: none
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column MesNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e992d4a3-ffad-4bc6-a594-288a5d1d3ec4
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesNum]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 02e68db1-1c30-40ab-b004-3bb6fa2c83d5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: MesNum

		annotation SummarizationSetBy = Automatic

	column AñoMes
		dataType: string
		lineageTag: 9f063940-1b1b-444b-bdce-7f523042c72f
		summarizeBy: none
		isNameInferred
		sourceColumn: [AñoMes]

		annotation SummarizationSetBy = Automatic

	column Día
		dataType: int64
		formatString: 0
		lineageTag: 7146bdd4-d348-442f-bf86-57098ce676fa
		summarizeBy: none
		isNameInferred
		sourceColumn: [Día]

		annotation SummarizationSetBy = Automatic

	column DiaSemanaNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fcf446ab-9de1-4c60-aaff-0d5a6921013f
		summarizeBy: none
		isNameInferred
		sourceColumn: [DiaSemanaNum]

		annotation SummarizationSetBy = Automatic

	column DiaSemana
		dataType: string
		lineageTag: 68e18c0d-8e63-457d-b7fa-1119f93119d0
		summarizeBy: none
		isNameInferred
		sourceColumn: [DiaSemana]
		sortByColumn: DiaSemanaNum

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = calculated
		mode: import
		source =
				SELECTCOLUMNS (
				    CALENDAR ( DATE ( 2010, 1, 1 ), DATE ( 2017, 12, 31 ) ),
				    "Fecha", [Date],
				    "Año", YEAR ( [Date] ),
				    "MesNum", MONTH ( [Date] ),
				    "Mes", FORMAT ( [Date], "mmm" ),
				    "AñoMes", FORMAT ( [Date], "yyyy-mm" ),
				    "Día", DAY ( [Date] ),
				    "DiaSemanaNum", WEEKDAY ( [Date], 2 ),
				    "DiaSemana", SWITCH ( WEEKDAY ( [Date], 2 ), 1, "Lun", 2, "Mar", 3, "Mié", 4, "Jue", 5, "Vie", 6, "Sáb", "Dom" )
				)

	annotation PBI_Id = calendar

