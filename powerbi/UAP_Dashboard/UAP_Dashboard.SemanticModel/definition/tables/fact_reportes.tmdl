	partition fact_reportes = m
		mode: import
		source =
				let
				    Ruta = "C:\Users\usuario\Documents\Universidad\sexto semestre\eda\PowerBI_kit\data\",
				    Origen = Csv.Document(File.Contents(Ruta & "uap_procesado.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encab = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encab, {{"id", type text}, {"fecha_hora", type datetime}, {"fecha", type date}, {"hora_conocida", Int64.Type}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"dia_semana_num", Int64.Type}, {"dia_semana", type text}, {"hora", Int64.Type}, {"fin_de_semana", Int64.Type}, {"franja_dia", type text}, {"festivo_pirotecnia", Int64.Type}, {"lat", type number}, {"lng", type number}, {"pais", type text}, {"pais_imputado", Int64.Type}, {"forma_reportada", type text}, {"forma", type text}, {"grupo_forma", type text}, {"duracion_seg_reportada", type number}, {"duracion_seg", type number}, {"duracion_imputada", Int64.Type}, {"duracion_atipica", Int64.Type}, {"log_duracion", type number}, {"rango_duracion", type text}, {"rango_duracion_orden", Int64.Type}, {"posible_duplicado", Int64.Type}, {"cluster_geo", Int64.Type}}, "en-US"),
				    DurMin = Table.AddColumn(Tipos, "duracion_min", each [duracion_seg] / 60, type number),
				    OrdenFranja = Table.AddColumn(DurMin, "franja_orden", each if Text.StartsWith([franja_dia], "Madrugada") then 1 else if Text.StartsWith([franja_dia], "Mañana") then 2 else if Text.StartsWith([franja_dia], "Tarde") then 3 else if Text.StartsWith([franja_dia], "Noche") then 4 else 5, Int64.Type),
				    EtiqPir = Table.AddColumn(OrdenFranja, "festivo_etiqueta", each if [festivo_pirotecnia] = 1 then "Festivo con pirotecnia" else "Día normal", type text)
				in
				    EtiqPir

	annotation PBI_ResultType = Table

