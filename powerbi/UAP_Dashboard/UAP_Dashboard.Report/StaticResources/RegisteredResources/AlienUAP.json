{
  "name": "Alien UAP",
  "dataColors": [
    "#39FF88",
    "#A78BFA",
    "#8C8C8C",
    "#2DD4BF",
    "#C4B5FD",
    "#86EFAC",
    "#6D5BD0",
    "#4B5563"
  ],
  "background": "#0B1426",
  "foreground": "#E6EDF7",
  "tableAccent": "#39FF88",
  "good": "#39FF88",
  "neutral": "#8C8C8C",
  "bad": "#F472B6",
  "maximum": "#39FF88",
  "center": "#1F3B35",
  "minimum": "#0B1426",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#39FF88"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EDF7"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EDF7"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#9FB0C8"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#050A14"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#020409"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B1426"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#16362F"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#39FF88"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#9FB0C8"
              }
            },
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9FB0C8"
              }
            },
            "fontSize": 10,
            "gridlineShow": false,
            "lineColor": {
              "solid": {
                "color": "#223049"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9FB0C8"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#17233A"
              }
            },
            "gridlineShow": true
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#9FB0C8"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "fontSize": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#39FF88"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#9FB0C8"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#39FF88"
              }
            },
            "show": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "background": {
              "solid": {
                "color": "#0F1B33"
              }
            }
          }
        ]
      }
    }
  }
}